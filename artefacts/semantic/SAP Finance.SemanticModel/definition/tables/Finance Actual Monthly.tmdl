/// Pre-aggregated monthly actual amounts by conformed Finance dimensions.
table 'Finance Actual Monthly'

	/// Monthly actual amount in local currency.
	measure 'Monthly Actual Local Amount' = IF(ISEMPTY('Finance Actual Monthly') || (HASONEVALUE('Finance Actual Monthly'[SAP Client]) && HASONEVALUE('Finance Actual Monthly'[Ledger]) && HASONEVALUE('Finance Actual Monthly'[Local Currency])), SUM('Finance Actual Monthly'[Actual Amount Local]), ERROR("Select one SAP client, ledger and local currency."))
		formatString: #,##0.00
		displayFolder: Amounts

	/// Monthly actual amount in global currency; the legacy Group label is retained.
	measure 'Monthly Actual Group Amount' = IF(ISEMPTY('Finance Actual Monthly') || (HASONEVALUE('Finance Actual Monthly'[SAP Client]) && HASONEVALUE('Finance Actual Monthly'[Ledger]) && HASONEVALUE('Finance Actual Monthly'[Group Currency])), SUM('Finance Actual Monthly'[Actual Amount Group]), ERROR("Select one SAP client, ledger and global currency."))
		formatString: #,##0.00
		displayFolder: Amounts

	/// Monthly actual amount in transaction currency.
	measure 'Monthly Actual Transaction Amount' = IF(ISEMPTY('Finance Actual Monthly') || (HASONEVALUE('Finance Actual Monthly'[SAP Client]) && HASONEVALUE('Finance Actual Monthly'[Ledger]) && HASONEVALUE('Finance Actual Monthly'[Transaction Currency])), SUM('Finance Actual Monthly'[Actual Amount Transaction]), ERROR("Select one SAP client, ledger and balance transaction currency."))
		formatString: #,##0.00
		displayFolder: Amounts

	/// Monthly quantity from the derived actuals fact.
	measure 'Monthly Actual Quantity' = SUM('Finance Actual Monthly'[Total Quantity])
		formatString: #,##0.000
		displayFolder: Volumes

	/// Monthly finance line count at the current filter grain.
	measure 'Monthly Actual Line Count' = SUM('Finance Actual Monthly'[Line Item Count])
		formatString: #,##0
		displayFolder: Counts

	/// SAP client in the serving grain.
	column 'SAP Client'
		dataType: string
		summarizeBy: none
		sourceColumn: client

	/// Ledger in the serving grain.
	column 'Ledger'
		dataType: string
		summarizeBy: none
		sourceColumn: ledger

	/// Currency of actual_amount_local.
	column 'Local Currency'
		dataType: string
		summarizeBy: none
		sourceColumn: currency_local

	/// Global currency of actual_amount_group.
	column 'Group Currency'
		dataType: string
		summarizeBy: none
		sourceColumn: currency_group

	/// Balance transaction currency of actual_amount_transaction.
	column 'Transaction Currency'
		dataType: string
		summarizeBy: none
		sourceColumn: currency_transaction

	column 'Company Key'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: company_sk

	column 'Division Key'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: division_sk

	column 'Profit Center Key'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: profit_center_sk

	column 'Cost Center Key'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: cost_center_sk

	column 'GL Account Key'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: gl_account_sk

	column 'Fiscal Period Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: fiscal_period_key

	column 'Actual Amount Local'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: actual_amount_local

	column 'Actual Amount Group'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: actual_amount_group

	column 'Actual Amount Transaction'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: actual_amount_transaction

	column 'Total Quantity'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: total_quantity

	column 'Line Item Count'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: line_item_count

	partition 'Finance Actual Monthly' = entity
		mode: directLake
		source
			entityName: finance_actual_monthly
			schemaName: mlv
			expressionSource: 'DirectLake - SAP Finance'
