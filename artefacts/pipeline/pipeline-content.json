{
  "properties": {
    "activities": [
      {
        "name": "set_run_upper_bound",
        "type": "SetVariable",
        "dependsOn": [],
        "typeProperties": {
          "variableName": "run_upper_bound_utc",
          "value": {"value":"@formatDateTime(utcNow(),'yyyy-MM-ddTHH:mm:ss.fffZ')","type":"Expression"}
        }
      },
      {
        "name": "nb_schema_val",
        "description": "Validate metadata, acquire the source writer and persist an immutable extraction plan.",
        "type": "TridentNotebook",
        "dependsOn": [{"activity":"set_run_upper_bound","dependencyConditions":["Succeeded"]}],
        "policy": {"timeout":"0.12:00:00","retry":0,"retryIntervalInSeconds":30},
        "typeProperties": {
          "notebookId": "__NOTEBOOK_ID__",
          "workspaceId": "__WORKSPACE_ID__",
          "parameters": {
            "run_id": {"value":{"value":"@if(empty(pipeline().parameters.p_run_id),pipeline().RunId,pipeline().parameters.p_run_id)","type":"Expression"},"type":"string"},
            "run_upper_bound_utc": {"value":{"value":"@variables('run_upper_bound_utc')","type":"Expression"},"type":"string"},
            "operation": {"value":{"value":"@pipeline().parameters.p_operation","type":"Expression"},"type":"string"},
            "requested_partitions": {"value":{"value":"@string(pipeline().parameters.p_partitions)","type":"Expression"},"type":"string"},
            "max_parallelism": {"value":{"value":"@pipeline().parameters.p_max_parallelism","type":"Expression"},"type":"int"},
            "table_config": {"value":{"value":"@string(pipeline().parameters.p_table_config)","type":"Expression"},"type":"string"}
          }
        }
      },
      {
        "name": "fe_copy_sap_full_snapshot",
        "description": "Existing Copy loop, now bounded and metadata-driven for all four extraction modes.",
        "type": "ForEach",
        "dependsOn": [{"activity":"nb_schema_val","dependencyConditions":["Succeeded"]}],
        "typeProperties": {
          "items": {"value":"@json(activity('nb_schema_val').output.result.exitValue).work_items","type":"Expression"},
          "isSequential": false,
          "batchCount": {"value":"@pipeline().parameters.p_max_parallelism","type":"Expression"},
          "activities": [
            {
              "name": "cpy_full_table_snapshot",
              "description": "Read one approved logical extraction with same-statement source controls.",
              "type": "Copy",
              "dependsOn": [],
              "policy": {"timeout":"0.12:00:00","retry":2,"retryIntervalInSeconds":30,"secureOutput":false,"secureInput":false},
              "typeProperties": {
                "source": {
                  "type": "FabricSqlDatabaseSource",
                  "sqlReaderQuery": {"value":"@item().source_query","type":"Expression"},
                  "queryTimeout": "02:00:00",
                  "partitionOption": "None",
                  "datasetSettings": {
                    "annotations": [],
                    "connectionSettings": {
                      "name": "conn_sap_finance_sql",
                      "properties": {
                        "annotations": [],
                        "type": "FabricSqlDatabase",
                        "typeProperties": {"workspaceId":"__WORKSPACE_ID__","artifactId":"__SQL_DATABASE_ID__"},
                        "externalReferences": {"connection":"__SQL_CONNECTION_ID__"}
                      }
                    },
                    "type": "FabricSqlDatabaseTable",
                    "schema": [],
                    "typeProperties": {}
                  }
                },
                "sink": {
                  "type": "DelimitedTextSink",
                  "storeSettings": {"type":"LakehouseWriteSettings"},
                  "formatSettings": {"type":"DelimitedTextWriteSettings","quoteAllText":true,"fileExtension":".csv"},
                  "datasetSettings": {
                    "annotations": [],
                    "type": "DelimitedText",
                    "typeProperties": {
                      "location": {
                        "type": "LakehouseLocation",
                        "fileName": "data.csv",
                        "folderPath": {"value":"@item().sink_folder","type":"Expression"}
                      },
                      "columnDelimiter": ",",
                      "escapeChar": "\\",
                      "firstRowAsHeader": true,
                      "quoteChar": "\""
                    },
                    "schema": [],
                    "linkedService": {
                      "name": "lh_brz_slv_finance",
                      "properties": {
                        "annotations": [],
                        "type": "Lakehouse",
                        "typeProperties": {"workspaceId":"__WORKSPACE_ID__","artifactId":"__BRONZE_LAKEHOUSE_ID__","rootFolder":"Files"}
                      }
                    }
                  }
                },
                "parallelCopies": 1,
                "enableStaging": false,
                "validateDataConsistency": true,
                "translator": {
                  "type": "TabularTranslator",
                  "typeConversion": true,
                  "typeConversionSettings": {"allowDataTruncation":false,"treatBooleanAsNumber":false}
                }
              }
            },
            {
              "name": "nb_tbl_inventory",
              "type": "TridentNotebook",
              "dependsOn": [{"activity":"cpy_full_table_snapshot","dependencyConditions":["Succeeded"]}],
              "policy": {"timeout":"0.12:00:00","retry":2,"retryIntervalInSeconds":30},
              "typeProperties": {
                "notebookId": "__NOTEBOOK_ID__",
                "workspaceId": "__WORKSPACE_ID__",
                "parameters": {
                  "work_id": {"value":{"value":"@item().work_id","type":"Expression"},"type":"string"},
                  "copy_output": {"value":{"value":"@string(activity('cpy_full_table_snapshot').output)","type":"Expression"},"type":"string"},
                  "table_config": {"value":{"value":"@string(pipeline().parameters.p_table_config)","type":"Expression"},"type":"string"}
                }
              }
            }
          ]
        }
      },
      {
        "name": "nb_brz_slv_sap",
        "type": "TridentNotebook",
        "dependsOn": [{"activity":"fe_copy_sap_full_snapshot","dependencyConditions":["Completed"]}],
        "policy": {"timeout":"0.12:00:00","retry":0,"retryIntervalInSeconds":30},
        "typeProperties": {
          "notebookId": "__NOTEBOOK_ID__",
          "workspaceId": "__WORKSPACE_ID__",
          "parameters": {
            "run_id": {"value":{"value":"@json(activity('nb_schema_val').output.result.exitValue).run_id","type":"Expression"},"type":"string"},
            "table_config": {"value":{"value":"@string(pipeline().parameters.p_table_config)","type":"Expression"},"type":"string"}
          }
        }
      },
      {
        "name": "nb_gld_dim_sap",
        "type": "TridentNotebook",
        "dependsOn": [{"activity":"nb_brz_slv_sap","dependencyConditions":["Succeeded"]}],
        "typeProperties": {
          "notebookId":"__NOTEBOOK_ID__","workspaceId":"__WORKSPACE_ID__",
          "parameters":{"run_id":{"value":{"value":"@json(activity('nb_schema_val').output.result.exitValue).run_id","type":"Expression"},"type":"string"}}
        }
      },
      {
        "name": "nb_gld_fct_fin_sap",
        "type": "TridentNotebook",
        "dependsOn": [{"activity":"nb_gld_dim_sap","dependencyConditions":["Succeeded"]}],
        "typeProperties": {
          "notebookId":"__NOTEBOOK_ID__","workspaceId":"__WORKSPACE_ID__",
          "parameters":{"run_id":{"value":{"value":"@json(activity('nb_schema_val').output.result.exitValue).run_id","type":"Expression"},"type":"string"}}
        }
      },
      {
        "name": "nb_gld_bgt_sap",
        "type": "TridentNotebook",
        "dependsOn": [{"activity":"nb_gld_dim_sap","dependencyConditions":["Succeeded"]}],
        "typeProperties": {
          "notebookId":"__NOTEBOOK_ID__","workspaceId":"__WORKSPACE_ID__",
          "parameters":{"run_id":{"value":{"value":"@json(activity('nb_schema_val').output.result.exitValue).run_id","type":"Expression"},"type":"string"}}
        }
      },
      {
        "name": "nb_gld_fct_mlv",
        "type": "TridentNotebook",
        "dependsOn": [
          {"activity":"nb_gld_fct_fin_sap","dependencyConditions":["Succeeded"]},
          {"activity":"nb_gld_bgt_sap","dependencyConditions":["Succeeded"]}
        ],
        "typeProperties": {"notebookId":"__NOTEBOOK_ID__","workspaceId":"__WORKSPACE_ID__"}
      },
      {
        "name": "nb_full_validation",
        "type": "TridentNotebook",
        "dependsOn": [{"activity":"nb_gld_fct_mlv","dependencyConditions":["Succeeded"]}],
        "typeProperties": {
          "notebookId":"__NOTEBOOK_ID__","workspaceId":"__WORKSPACE_ID__",
          "parameters":{"run_id":{"value":{"value":"@json(activity('nb_schema_val').output.result.exitValue).run_id","type":"Expression"},"type":"string"}}
        }
      },
      {
        "name": "nb_bronze_cleanup",
        "description": "Commit validated checkpoints; retain immutable Bronze for recovery and reconciliation.",
        "type": "TridentNotebook",
        "dependsOn": [{"activity":"nb_full_validation","dependencyConditions":["Succeeded"]}],
        "typeProperties": {
          "notebookId":"__NOTEBOOK_ID__","workspaceId":"__WORKSPACE_ID__",
          "parameters": {
            "run_id":{"value":{"value":"@json(activity('nb_schema_val').output.result.exitValue).run_id","type":"Expression"},"type":"string"},
            "table_config":{"value":{"value":"@string(pipeline().parameters.p_table_config)","type":"Expression"},"type":"string"}
          }
        }
      }
    ],
    "parameters": {
      "p_operation": {"type":"String","defaultValue":"AUTO"},
      "p_run_id": {"type":"String","defaultValue":""},
      "p_partitions": {"type":"Array","defaultValue":[]},
      "p_max_parallelism": {"type":"Int","defaultValue":2},
      "p_table_config": {"type":"Array","defaultValue":[]}
    },
    "variables": {"run_upper_bound_utc":{"type":"String","defaultValue":""}}
  }
}
