{
  "properties": {
    "activities": [
      {
        "name": "set_run_upper_bound",
        "description": "Capture one immutable UTC upper bound for this run.",
        "type": "SetVariable",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "variableName": "run_upper_bound_utc",
          "value": {
            "value": "@formatDateTime(utcNow(),'yyyy-MM-ddTHH:mm:ss.fff')",
            "type": "Expression"
          }
        }
      },
      {
        "name": "fe_copy_sap_full_snapshot",
        "description": "Sequentially copy complete SAP source projections to dated Bronze snapshots.",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "set_run_upper_bound",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@pipeline().parameters.p_table_config",
            "type": "Expression"
          },
          "isSequential": true,
          "activities": [
            {
              "name": "cpy_full_table_snapshot",
              "description": "Copy the complete source projection to one dated Bronze CSV.",
              "type": "Copy",
              "dependsOn": [],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 2,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "FabricSqlDatabaseSource",
                  "sqlReaderQuery": {
                    "value": "@concat('SELECT ',item().columnList,' FROM ',item().sourceObject)",
                    "type": "Expression"
                  },
                  "queryTimeout": "02:00:00",
                  "partitionOption": "None",
                  "datasetSettings": {
                    "annotations": [],
                    "connectionSettings": {
                      "name": "conn_sap_finance_sql",
                      "properties": {
                        "annotations": [],
                        "type": "FabricSqlDatabase",
                        "typeProperties": {
                          "workspaceId": "__WORKSPACE_ID__",
                          "artifactId": "__SQL_DATABASE_ID__"
                        },
                        "externalReferences": {
                          "connection": "__SQL_CONNECTION_ID__"
                        }
                      }
                    },
                    "type": "FabricSqlDatabaseTable",
                    "schema": [],
                    "typeProperties": {}
                  }
                },
                "sink": {
                  "type": "DelimitedTextSink",
                  "storeSettings": {
                    "type": "LakehouseWriteSettings"
                  },
                  "formatSettings": {
                    "type": "DelimitedTextWriteSettings",
                    "quoteAllText": true,
                    "fileExtension": ".csv"
                  },
                  "datasetSettings": {
                    "annotations": [],
                    "type": "DelimitedText",
                    "typeProperties": {
                      "location": {
                        "type": "LakehouseLocation",
                        "fileName": {
                          "value": "@concat(item().filePrefix,'_',formatDateTime(variables('run_upper_bound_utc'),'yyyyMMdd'),'.csv')",
                          "type": "Expression"
                        },
                        "folderPath": {
                          "value": "@item().sinkFolder",
                          "type": "Expression"
                        }
                      },
                      "columnDelimiter": ",",
                      "escapeChar": "\\",
                      "firstRowAsHeader": true,
                      "quoteChar": "\""
                    },
                    "schema": [],
                    "linkedService": {
                      "name": "lh_brz_slv_finance",
                      "properties": {
                        "annotations": [],
                        "type": "Lakehouse",
                        "typeProperties": {
                          "workspaceId": "__WORKSPACE_ID__",
                          "artifactId": "__BRONZE_LAKEHOUSE_ID__",
                          "rootFolder": "Files"
                        }
                      }
                    }
                  }
                },
                "enableStaging": false,
                "validateDataConsistency": true,
                "translator": {
                  "type": "TabularTranslator",
                  "typeConversion": true,
                  "typeConversionSettings": {
                    "allowDataTruncation": false,
                    "treatBooleanAsNumber": false
                  }
                }
              }
            }
          ]
        }
      },
      {
        "name": "nb_schema_val",
        "description": "schema validation pre-run",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "fe_copy_sap_full_snapshot",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "__NOTEBOOK_ID__",
          "workspaceId": "__WORKSPACE_ID__"
        }
      },
      {
        "name": "nb_tbl_inventory",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "nb_schema_val",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "__NOTEBOOK_ID__",
          "workspaceId": "__WORKSPACE_ID__",
          "parameters": {
            "processing_date": {
              "value": {
                "value": "@formatDateTime(variables('run_upper_bound_utc'),'yyyy-MM-dd')",
                "type": "Expression"
              },
              "type": "string"
            }
          }
        }
      },
      {
        "name": "nb_brz_slv_sap",
        "description": "Transform SAP HANA Finance CSV records from Bronze layer to Silver",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "nb_tbl_inventory",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "__NOTEBOOK_ID__",
          "workspaceId": "__WORKSPACE_ID__",
          "parameters": {
            "processing_date": {
              "value": {
                "value": "@formatDateTime(variables('run_upper_bound_utc'),'yyyy-MM-dd')",
                "type": "Expression"
              },
              "type": "string"
            }
          }
        }
      },
      {
        "name": "nb_gld_dim_sap",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "nb_brz_slv_sap",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "__NOTEBOOK_ID__",
          "workspaceId": "__WORKSPACE_ID__"
        }
      },
      {
        "name": "nb_gld_fct_fin_sap",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "nb_gld_dim_sap",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "__NOTEBOOK_ID__",
          "workspaceId": "__WORKSPACE_ID__"
        }
      },
      {
        "name": "nb_gld_bgt_sap",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "nb_gld_dim_sap",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "__NOTEBOOK_ID__",
          "workspaceId": "__WORKSPACE_ID__"
        }
      },
      {
        "name": "nb_gld_fct_mlv",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "nb_gld_fct_fin_sap",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "nb_gld_bgt_sap",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "__NOTEBOOK_ID__",
          "workspaceId": "__WORKSPACE_ID__"
        }
      },
      {
        "name": "nb_full_validation",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "nb_gld_fct_mlv",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "__NOTEBOOK_ID__",
          "workspaceId": "__WORKSPACE_ID__"
        }
      },
      {
        "name": "nb_bronze_cleanup",
        "description": "Retain the current Bronze snapshot and delete older snapshots after successful validation.",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "nb_full_validation",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "__NOTEBOOK_ID__",
          "workspaceId": "__WORKSPACE_ID__",
          "parameters": {
            "processing_date": {
              "value": {
                "value": "@formatDateTime(variables('run_upper_bound_utc'),'yyyy-MM-dd')",
                "type": "Expression"
              },
              "type": "string"
            }
          }
        }
      }
    ],
    "parameters": {
      "p_table_config": {
        "type": "Array",
        "defaultValue": [
          {
            "name": "ACDOCA",
            "sinkFolder": "bronze/sap_finance/acdoca",
            "filePrefix": "acdoca",
            "columnList": "[RCLNT],[RLDNR],[RBUKRS],[GJAHR],[POPER],[BELNR],[DOCLN],[RACCT],[RCNTR],[PRCTR],[KOKRS],[LIFNR],[KUNNR],[BUDAT],[BLDAT],[DRCRK],[BLART],[AWTYP],[SGTXT],[RHCUR],[RKCUR],[RWCUR],[HSL],[KSL],[TSL],[WSL],[MSL]",
            "sourceObject": "[SAPABAP1].[ACDOCA]"
          },
          {
            "name": "BKPF",
            "sinkFolder": "bronze/sap_finance/bkpf",
            "filePrefix": "bkpf",
            "columnList": "[MANDT],[BUKRS],[GJAHR],[BELNR],[MONAT],[BUDAT],[BLDAT],[BLART],[STBLG],[BKTXT]",
            "sourceObject": "[SAPABAP1].[BKPF]"
          },
          {
            "name": "T001",
            "sinkFolder": "bronze/sap_finance/t001",
            "filePrefix": "t001",
            "columnList": "[MANDT],[BUKRS],[BUTXT],[ORT01],[LAND1],[WAERS],[KTOPL]",
            "sourceObject": "[SAPABAP1].[T001]"
          },
          {
            "name": "CSKS",
            "sinkFolder": "bronze/sap_finance/csks",
            "filePrefix": "csks",
            "columnList": "[MANDT],[KOKRS],[KOSTL],[BUKRS],[PRCTR],[VERAK],[KOSAR],[KHINR],[DATAB],[DATBI]",
            "sourceObject": "[SAPABAP1].[CSKS]"
          },
          {
            "name": "CEPC",
            "sinkFolder": "bronze/sap_finance/cepc",
            "filePrefix": "cepc",
            "columnList": "[MANDT],[KOKRS],[PRCTR],[BUKRS],[VERAK],[KHINR],[SEGMENT],[DATAB],[DATBI]",
            "sourceObject": "[SAPABAP1].[CEPC]"
          },
          {
            "name": "SKA1",
            "sinkFolder": "bronze/sap_finance/ska1",
            "filePrefix": "ska1",
            "columnList": "[MANDT],[KTOPL],[SAKNR],[XBILK],[GVTYP],[KTOKS]",
            "sourceObject": "[SAPABAP1].[SKA1]"
          },
          {
            "name": "SKAT",
            "sinkFolder": "bronze/sap_finance/skat",
            "filePrefix": "skat",
            "columnList": "[MANDT],[SPRAS],[KTOPL],[SAKNR],[TXT20],[TXT50]",
            "sourceObject": "[SAPABAP1].[SKAT]"
          },
          {
            "name": "LFA1",
            "sinkFolder": "bronze/sap_finance/lfa1",
            "filePrefix": "lfa1",
            "columnList": "[MANDT],[LIFNR],[NAME1],[NAME2],[LAND1],[ORT01],[REGIO],[KTOKK],[STCD1]",
            "sourceObject": "[SAPABAP1].[LFA1]"
          },
          {
            "name": "KNA1",
            "sinkFolder": "bronze/sap_finance/kna1",
            "filePrefix": "kna1",
            "columnList": "[MANDT],[KUNNR],[NAME1],[NAME2],[LAND1],[ORT01],[REGIO],[KTOKD],[STCD1]",
            "sourceObject": "[SAPABAP1].[KNA1]"
          },
          {
            "name": "FAGLFLEXP",
            "sinkFolder": "bronze/sap_finance/faglflexp",
            "filePrefix": "faglflexp",
            "columnList": "[RCLNT],[RLDNR],[RBUKRS],[RYEAR],[RACCT],[PRCTR],[KOKRS],[VERSN],[CURTYPE],[RHCUR],[TSL01],[TSL02],[TSL03],[TSL04],[TSL05],[TSL06],[TSL07],[TSL08],[TSL09],[TSL10],[TSL11],[TSL12],[TSL13],[TSL14],[TSL15],[TSL16]",
            "sourceObject": "[SAPABAP1].[FAGLFLEXP]"
          },
          {
            "name": "BUDGET",
            "sinkFolder": "bronze/sap_finance/budget",
            "filePrefix": "budget",
            "columnList": "[COMPANY_CODE],[GL_ACCOUNT],[COST_CENTER],[PROFIT_CENTER],[FISCAL_YEAR],[FISCAL_PERIOD],[BUDGET_AMOUNT_LOCAL],[FORECAST_AMOUNT_LOCAL],[PLAN_VERSION],[DATA_CLASSIFICATION]",
            "sourceObject": "[SAPDEMO].[BUDGET]"
          },
          {
            "name": "DIVISION_REFERENCE",
            "sinkFolder": "bronze/sap_finance/division_reference",
            "filePrefix": "division_reference",
            "columnList": "[DIVISION_CODE],[DIVISION_NAME]",
            "sourceObject": "[SAPDEMO].[DIVISION_REFERENCE]"
          },
          {
            "name": "GL_ACCOUNT_REFERENCE",
            "sinkFolder": "bronze/sap_finance/gl_account_reference",
            "filePrefix": "gl_account_reference",
            "columnList": "[GL_ACCOUNT],[GL_ACCOUNT_NAME],[FINANCE_CATEGORY]",
            "sourceObject": "[SAPDEMO].[GL_ACCOUNT_REFERENCE]"
          }
        ]
      }
    },
    "variables": {
      "run_upper_bound_utc": {
        "type": "String",
        "defaultValue": ""
      }
    }
  }
}